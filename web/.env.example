# Robinhood Chain RPC for the browser. Use a key restricted to your domain, because anything
# NEXT_PUBLIC_ is visible to visitors. Blank = the public RPC.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Contract addresses come from the deploy (web/src/generated/book.json and generated/vaults), written by
# ./launch.sh and ./set-token.sh. Nothing to set here for production.

# Optional: your site address and X profile (link previews, footer).
NEXT_PUBLIC_DOMAIN=
NEXT_PUBLIC_X_URL=
