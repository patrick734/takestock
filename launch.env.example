# Copy to launch.env. Addresses only: never put a private key in this file.

# Printed by: node tools/wallet.js keeper-secret
KEEPER_ADDRESS=0x...

# Leave empty: the token launches on Pons after the deploy, then ./set-token.sh plugs it in.
TOKEN_ADDRESS=

# Optional: your own Robinhood Chain RPC if the public one keeps dropping connections. Add it with the hidden prompt
# in the launch guide so it never shows on screen.
